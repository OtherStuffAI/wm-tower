FORGEJO__database__DB_TYPE=sqlite3
FORGEJO__server__ROOT_URL=https://tower-stable-forgejo.b.otherstuff.ai/
FORGEJO__server__HTTP_ADDR=0.0.0.0
FORGEJO__server__DISABLE_SSH=true
FORGEJO__security__INSTALL_LOCK=true
FORGEJO__security__REVERSE_PROXY_TRUSTED_PROXIES=10.0.0.0/8
FORGEJO__service__DISABLE_REGISTRATION=true
FORGEJO__service__REQUIRE_SIGNIN_VIEW=true
FORGEJO__service__ENABLE_INTERNAL_SIGNIN=false
FORGEJO__service__ENABLE_BASIC_AUTHENTICATION=false
FORGEJO__service__ENABLE_REVERSE_PROXY_AUTHENTICATION=true
FORGEJO__service__ENABLE_REVERSE_PROXY_AUTHENTICATION_API=true
FORGEJO__service__ENABLE_REVERSE_PROXY_AUTO_REGISTRATION=false
FORGEJO__service__ENABLE_REVERSE_PROXY_FULL_NAME=true
FORGEJO__oauth2_client__ENABLE_AUTO_REGISTRATION=true
FORGEJO__oauth2_client__USERNAME=preferred_username
FORGEJO__oauth2_client__ACCOUNT_LINKING=disabled
FORGEJO__oauth2_client__OPENID_CONNECT_SCOPES=profile email
FORGEJO__ui__DEFAULT_SHOW_FULL_NAME=true
FORGEJO__repository__ENABLE_PUSH_CREATE_USER=false
FORGEJO__repository__ENABLE_PUSH_CREATE_ORG=false
FORGEJO__security__DISABLE_GIT_HOOKS=true
FORGEJO__actions__ENABLED=false
FORGEJO__webhook__ALLOWED_HOST_LIST=private
