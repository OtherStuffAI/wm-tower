TOWER_RUNTIME_ROLE=git-org-reconciler
NODE_ENV=production

# The worker is private. These URLs use CapRover service DNS and are the only
# provider/Tower locations needed when installing the stack under other names.
GIT_GATEWAY_TOWER_URL=http://srv-captain--tower-stable-api:3100
GIT_FORGEJO_BASE_URL=http://srv-captain--tower-stable-forgejo-provider:3000
GIT_INTERNAL_SERVICE_TOKEN=REPLACE_WITH_THE_TOWER_API_INTERNAL_SERVICE_TOKEN
GIT_FORGEJO_CONTROL_TOKEN=REPLACE_AFTER_BOOTSTRAPPING_THE_NON_ADMIN_RECONCILER
