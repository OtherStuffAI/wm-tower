{
  "contract_name": "flightdeck_pg.channel_messages.create",
  "fixture_version": 1,
  "route": "/api/v4/flightdeck-pg/workspaces/{workspaceId}/channels/{channelId}/messages",
  "method": "POST",
  "required_nip98_actor": "workspace_member",
  "required_app_npub": "npub17qr2rr2k20zwmaferler5c0s8lur6gm73q8wvyv8l20n0xsz3c9q7m7fll",
  "required_permissions": ["channel.write"],
  "stable_identity_fields": [
    "tower_service_npub",
    "workspace_service_npub",
    "workspace_owner_npub",
    "workspace_id",
    "app_npub"
  ],
  "request_shape": {
    "type": "object",
    "required": ["body"],
    "properties": {
      "body": "string; may be empty only for an attachment-only message",
      "thread_id": "optional same-channel thread UUID",
      "create_thread": "optional boolean; when true, response also includes thread",
      "thread_title": "optional title when create_thread is true",
      "client_request_id": "optional caller-scoped idempotency key",
      "mentions": "optional typed alias for metadata.mentions",
      "metadata": "optional object; metadata.mentions accepts structured agent mentions",
      "message_signature": "validated instruction signature; metadata provenance cannot override authorship"
    }
  },
  "response_shape": {
    "type": "object",
    "required": ["identity", "message", "created", "replayed"],
    "properties": {
      "identity": "FlightDeckPgIdentityFields",
      "message": "created canonical message row",
      "thread": "created canonical thread row when create_thread is true",
      "audit": "write audit metadata",
      "outbox": "message event cursor row for visible channel readers",
      "thread_outbox": "thread event cursor row when create_thread is true"
      ,"created": "true for a new write and false for a replay"
      ,"replayed": "true only when an existing idempotent write is returned"
    }
  },
