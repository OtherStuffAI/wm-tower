  "request_shape": {
    "type": "object",
    "properties": {
      "row_version": "optional optimistic row_version",
      "mode": "empty-only",
      "client_mutation_id": "optional client-generated audit token"
    }
  },
  "response_shape": {
    "type": "object",
    "required": ["identity", "folder", "tombstone", "audit", "outbox"],
    "properties": {
      "identity": "FlightDeckPgIdentityFields",
      "folder": "soft-deleted canonical folder metadata row",
      "tombstone": "durable delete payload emitted through Drive delta/event replay",
      "audit": "write audit metadata",
      "outbox": "folder deleted event cursor row for visible channel readers"
    }
  },
  "error_shape": {
