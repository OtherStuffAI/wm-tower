      "required": ["identity", "code", "active_file_count", "active_folder_count", "folder"],
      "code": "folder_not_empty",
      "description": "Returned when empty-only deletion finds active children."
    },
    "409_stale_row_version": {
      "required": ["identity", "code", "folder"],
      "code": "stale_row_version",
      "description": "Returned when row_version does not match the active folder."
    }
  },
