  "contract_name": "flightdeck_pg.file_folders.delete",
  "fixture_version": 1,
  "route": "/api/v4/flightdeck-pg/workspaces/{workspaceId}/file-folders/{folderId}",
  "method": "DELETE",
  "required_nip98_actor": "workspace_member",
