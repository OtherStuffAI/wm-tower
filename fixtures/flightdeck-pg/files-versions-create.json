      "file": "updated canonical file metadata row with current_version_id and object route",
      "version": "created file version metadata with base_version_id and storage object digest fields",
      "storage_link": "Tower storage link metadata only",
      "audit": "write audit metadata",
      "outbox": "file update event cursor row for visible channel readers"
    }
  },
