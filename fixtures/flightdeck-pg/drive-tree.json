{
  "contract_name": "flightdeck_pg.drive.tree",
  "fixture_version": 1,
  "route": "/api/v4/flightdeck-pg/workspaces/{workspaceId}/drive/tree",
  "method": "GET",
  "required_nip98_actor": "workspace_member",
