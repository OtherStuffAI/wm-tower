  "request_shape": {
    "query": {
      "scope_id": "optional Flight Deck PG scope UUID",
      "channel_id": "optional Flight Deck PG channel UUID",
      "parent_folder_id": "optional folder UUID; empty value lists root items",
      "cursor": "optional opaque Drive tree cursor returned as next_cursor",
      "limit": "optional integer, 1-200"
    }
  },
  "response_shape": {
    "type": "object",
    "required": ["identity", "items", "next_cursor", "cursor_semantics"],
    "properties": {
      "identity": "FlightDeckPgIdentityFields",
      "items": "array of visible active Drive file/folder metadata items",
      "next_cursor": "opaque cursor for the last returned item, or null",
      "cursor_semantics": "versioned description of stable sort-key pagination"
    }
  },
