+#[cfg(test)]
+mod poc_custody_tests {
+    use super::*;
+    use nostr::prelude::{Kind, Tag, Tags, Timestamp};
+    #[test]
+    fn http_custody_is_exact_and_session_bound() -> Result<()> {
+        let keys = Keys::generate();
+        let expected = EventBuilder::new(Kind::Custom(27235), "")
+            .custom_created_at(Timestamp::from(100))
+            .tags([
+                Tag::parse(["u", "http://test.invalid/synthetic.git"])?,
+                Tag::parse(["method", "GET"])?,
+            ])
+            .finalize_unsigned(keys.public_key());
+        let custody = Tag::parse([
+            "wm-session-capability",
+            "12345678-1234-1234-1234-123456789abc",
+            "session",
+            &"a".repeat(64),
+        ])?;
+        let mut candidate = expected.clone();
+        let mut tags: Vec<Tag> = candidate.tags.iter().cloned().collect();
+        tags.push(custody.clone());
+        candidate.tags = Tags::from_list(tags.clone());
+        let signed = keys.sign_event(candidate.clone())?;
+        assert!(
+            validate_poc_signed_event(
+                keys.public_key(),
+                &expected,
+                signed.clone(),
+                Some("session")
+            )
+            .is_ok()
+        );
+        assert!(
+            validate_poc_signed_event(keys.public_key(), &expected, signed, Some("wrong-session"))
+                .is_err()
+        );
+        tags.push(custody);
+        candidate.tags = Tags::from_list(tags);
+        assert!(
+            validate_poc_signed_event(
+                keys.public_key(),
+                &expected,
+                keys.sign_event(candidate)?,
+                Some("session")
+            )
+            .is_err()
+        );
+        let mut candidate = expected.clone();
+        let mut tags: Vec<Tag> = candidate.tags.iter().cloned().collect();
+        tags.push(Tag::parse([
+            "wm-session-capability",
+            "malformed",
+            "session",
+            "bad",
+        ])?);
+        candidate.tags = Tags::from_list(tags);
+        assert!(
+            validate_poc_signed_event(
+                keys.public_key(),
+                &expected,
+                keys.sign_event(candidate.clone())?,
+                Some("session")
+            )
+            .is_err()
+        );
+        let mut non_http = expected.clone();
+        non_http.kind = Kind::Custom(30618);
+        candidate.kind = non_http.kind;
+        let mut tags: Vec<Tag> = non_http.tags.iter().cloned().collect();
+        tags.push(Tag::parse([
+            "wm-session-capability",
+            "12345678-1234-1234-1234-123456789abc",
+            "session",
+            &"a".repeat(64),
+        ])?);
+        candidate.tags = Tags::from_list(tags);
+        assert!(
+            validate_poc_signed_event(
+                keys.public_key(),
+                &non_http,
+                keys.sign_event(candidate)?,
+                Some("session")
+            )
+            .is_err()
+        );
+        Ok(())
+    }
+}
