+// Pipes carry signatures only between ngit and the session broker. No shell,
+// socket listener, credential file, tracing, or publication is involved.
+async fn poc_broker_call(
+    bridge: &std::path::Path,
+    input: serde_json::Value,
+) -> Result<serde_json::Value> {
+    use std::process::Stdio;
+    use tokio::io::AsyncWriteExt;
+    let mut child = tokio::process::Command::new("bun")
+        .arg(bridge)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .kill_on_drop(true)
+        .spawn()
+        .context("could not start PoC broker bridge")?;
+    let mut stdin = child.stdin.take().context("missing bridge stdin")?;
+    stdin.write_all(&serde_json::to_vec(&input)?).await?;
+    drop(stdin);
+    let output = tokio::time::timeout(std::time::Duration::from_secs(15), child.wait_with_output())
+        .await??;
+    if !output.status.success() {
+        // Bridge emits only a sanitized error object, never input or credentials.
+        let error: serde_json::Value = serde_json::from_slice(&output.stderr).unwrap_or_default();
+        bail!(
+            "PoC broker: {}",
+            error["error"].as_str().unwrap_or("request failed")
+        );
+    }
+    serde_json::from_slice(&output.stdout).context("invalid bridge response")
+}
+
+fn validate_poc_signed_event(
+    public_key: PublicKey,
+    expected: &UnsignedEvent,
+    event: Event,
+    session_id: Option<&str>,
+) -> Result<Event> {
+    let mut tags: Vec<Vec<String>> = event.tags.iter().map(|t| t.as_slice().to_vec()).collect();
+    let expected_tags: Vec<Vec<String>> = expected
+        .tags
+        .iter()
+        .map(|t| t.as_slice().to_vec())
+        .collect();
+    if expected.kind.as_u16() == 27235 && tags.len() == 3 {
+        let custody = &tags[2];
+        if custody.len() == 4
+            && custody[0] == "wm-session-capability"
+            && Some(custody[2].as_str()) == session_id
+            && custody[1].len() == 36
+            && custody[1]
+                .chars()
+                .all(|c| c.is_ascii_hexdigit() || c == '-')
+            && custody[3].len() == 64
+            && custody[3].chars().all(|c| c.is_ascii_hexdigit())
+        {
+            tags.pop();
+        }
+    }
+    if event.pubkey != public_key
+        || event.pubkey != expected.pubkey
+        || event.kind != expected.kind
+        || event.content != expected.content
+        || tags != expected_tags
+        || event.created_at < expected.created_at
+        || event.created_at.as_secs() > expected.created_at.as_secs().saturating_add(5)
+    {
+        bail!("broker changed candidate or signing exceeded five seconds");
+    }
+    event.verify().context("invalid broker signature")?;
+    Ok(event)
+}
