+// No Client is created: this gate cannot connect to or publish on any relay.
+use anyhow::Result;
+use ngit::{NgitSigner, login::user::PrivateGitRelayList};
+use nostr::prelude::{EventBuilder, Kind, PublicKey, RelayUrl, Tag};
+use std::sync::Arc;
+#[tokio::main]
+async fn main() -> Result<()> {
+    let signer = Arc::new(NgitSigner::PocBroker {
+        public_key: PublicKey::parse(
+            "ffdc30446bede234446a69124bae94cdbddebf24f0abee4a5cabfc1124313c2e",
+        )?,
+        bridge: std::env::var("NGIT_POC_BROKER_BRIDGE")?.into(),
+    });
+    let relay = "ws://npub109684nue495hq240u3dqzyf2kltk23u3mqkk9l44ga6szed4jcysramf74.fips:41007/";
+    let clone = "http://npub109684nue495hq240u3dqzyf2kltk23u3mqkk9l44ga6szed4jcysramf74.fips:41007/npub1llwrq3rtah3rg3r2dyfyht55ek7aa0ey7z47ujju407pzfp38shqa7zcvr/synthetic.git";
+    signer
+        .sign_event_builder(
+            EventBuilder::new(Kind::Custom(27235), "")
+                .tags([Tag::parse(["u", clone])?, Tag::parse(["method", "GET"])?]),
+        )
+        .await?;
+    println!("native ngit broker HTTP signer: pass (signature discarded)");
+    // The exact stock private-init discovery-list conversion, before any publication.
+    let mut list = PrivateGitRelayList::new(vec![RelayUrl::parse(relay)?])?;
+    list.to_event(&signer).await?;
+    anyhow::bail!("unexpected discovery-list signing success; no event published")
+}
