+#[cfg(test)]
+mod poc_tests {
+    use super::*;
+    use nostr::prelude::{Kind, Tag, Timestamp};
+    #[test]
+    fn broker_responses_bind_fields_time_and_signature() -> Result<()> {
+        let keys = Keys::generate();
+        let expected = EventBuilder::new(Kind::Custom(30618), "")
+            .custom_created_at(Timestamp::from(100))
+            .tags([Tag::parse(["d", "synthetic"])?])
+            .finalize_unsigned(keys.public_key());
+        for seconds in [100, 105] {
+            let mut candidate = expected.clone();
+            candidate.created_at = Timestamp::from(seconds);
+            assert!(
+                validate_poc_signed_event(
+                    keys.public_key(),
+                    &expected,
+                    keys.sign_event(candidate)?,
+                    None
+                )
+                .is_ok()
+            );
+        }
+        for field in 0..7 {
+            let mut candidate = expected.clone();
+            match field {
+                0 => candidate.kind = Kind::Custom(1),
+                1 => candidate.content = "wrong".into(),
+                2 => {
+                    candidate.tags =
+                        nostr::prelude::Tags::from_list(vec![Tag::parse(["d", "other"])?])
+                }
+                3 => candidate.created_at = Timestamp::from(99),
+                4 => candidate.created_at = Timestamp::from(106),
+                _ => (),
+            }
+            let mut signed = keys.sign_event(candidate)?;
+            if field == 5 {
+                signed.pubkey = Keys::generate().public_key();
+            }
+            if field == 6 {
+                let other = Keys::generate();
+                let other_event = EventBuilder::new(Kind::Custom(1), "other")
+                    .finalize_unsigned(other.public_key());
+                signed.sig = other.sign_event(other_event)?.sig;
+            }
+            assert!(validate_poc_signed_event(keys.public_key(), &expected, signed, None).is_err());
+        }
+        Ok(())
+    }
+}
