@@ -0,0 +1,188 @@
+//! Explicit isolated synthetic mode; never enabled by normal CLI use.
+use crate::{
+    NgitSigner,
+    client::Params,
+    login::user::{UserGraspList, UserMetadata, UserRef, UserRelayRef, UserRelays},
+    repo_ref::RepoRef,
+};
+use anyhow::{Result, bail};
+use nostr::prelude::{PublicKey, RelayUrl, Timestamp};
+use std::sync::Arc;
+pub const RELAY: &str =
+    "ws://npub109684nue495hq240u3dqzyf2kltk23u3mqkk9l44ga6szed4jcysramf74.fips:41007/";
+pub const CLONE: &str = "http://npub109684nue495hq240u3dqzyf2kltk23u3mqkk9l44ga6szed4jcysramf74.fips:41007/npub1llwrq3rtah3rg3r2dyfyht55ek7aa0ey7z47ujju407pzfp38shqa7zcvr/synthetic.git";
+pub fn enabled() -> bool {
+    std::env::var("NGIT_POC_PRIVATE_SERVICE").as_deref() == Ok("1")
+}
+pub fn public_key() -> PublicKey {
+    PublicKey::parse("ffdc30446bede234446a69124bae94cdbddebf24f0abee4a5cabfc1124313c2e")
+        .expect("fixed public key")
+}
+pub fn signer() -> Arc<NgitSigner> {
+    Arc::new(NgitSigner::PocBroker {
+        public_key: public_key(),
+        bridge: "/Users/mini/code/wm/tower/poc/grasp/signer-bridge.ts".into(),
+    })
+}
+pub fn user() -> UserRef {
+    UserRef {
+        public_key: public_key(),
+        metadata: UserMetadata {
+            name: "synthetic publisher".into(),
+            created_at: Timestamp::from(0),
+            nip05: None,
+        },
+        relays: UserRelays {
+            relays: vec![UserRelayRef {
+                url: RELAY.into(),
+                read: true,
+                write: true,
+            }],
+            created_at: Timestamp::from(0),
+        },
+        grasp_list: UserGraspList {
+            urls: vec![],
+            created_at: Timestamp::from(0),
+        },
+    }
+}
+pub fn constrain_params(params: &mut Params) {
+    params.keys = None;
+    params.relay_default_set = vec![RELAY.into()];
+    params.announcement_indexer_relays = vec![];
+    params.blaster_relays = vec![];
+    params.fallback_signer_relays = vec![RELAY.into()];
+    params.grasp_default_set = vec![];
+}
+pub fn require_relay(url: &str) -> Result<()> {
+    if enabled() {
+        check_destination(url, RELAY)?;
+    }
+    Ok(())
+}
+pub fn require_git(url: &str) -> Result<()> {
+    if enabled() {
+        check_destination(url, CLONE)?;
+    }
+    Ok(())
+}
+pub fn require_repo(repo: &RepoRef) -> Result<()> {
+    if !repo.private
+        || repo.identifier != "synthetic"
+        || repo.name != "synthetic"
+        || repo.git_server != vec![CLONE.to_string()]
+        || repo.relays != vec![RelayUrl::parse(RELAY)?]
+        || repo.maintainers != vec![public_key()]
+        || repo.selected_maintainer != public_key()
+        || !repo.web.is_empty()
+        || !repo.upstream.is_empty()
+        || !repo.blossoms.is_empty()
+        || !repo.hashtags.is_empty()
+        || !repo.extra_tags.is_empty()
+        || !repo.role_tags.is_empty()
+        || !repo.moderators.is_empty()
+        || repo.lead.is_some()
+    {
+        bail!(
+            "PoC requires private synthetic repository: private={}, name={}, identifier={}, clone={:?}, relays={:?}, maintainer_count={}, web_count={}, upstream_count={}, blossom_count={}, hashtag_count={}, extra_count={}, role_count={}, moderator_count={}, lead={}",
+            repo.private,
+            repo.name,
+            repo.identifier,
+            repo.git_server,
+            repo.relays,
+            repo.maintainers.len(),
+            repo.web.len(),
+            repo.upstream.len(),
+            repo.blossoms.len(),
+            repo.hashtags.len(),
+            repo.extra_tags.len(),
+            repo.role_tags.len(),
+            repo.moderators.len(),
+            repo.lead.is_some()
+        );
+    }
+    Ok(())
+}
+
+fn check_destination(url: &str, expected: &str) -> Result<()> {
+    if url != expected {
+        bail!("PoC refuses noncanonical destination");
+    }
+    Ok(())
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn rejects_changed_origin_path_credentials_and_protocol() {
+        assert!(check_destination(RELAY, RELAY).is_ok());
+        assert!(check_destination(CLONE, CLONE).is_ok());
+        for bad in [
+            CLONE.replace("41007", "41008"),
+            CLONE.replace("synthetic", "other"),
+            format!("{CLONE}/"),
+            format!("{CLONE}?x=1"),
+            CLONE.replace("http://", "https://"),
+            CLONE.replace("http://", "http://user@"),
+            "https://example.invalid/synthetic.git".into(),
+        ] {
+            assert!(check_destination(&bad, CLONE).is_err());
+        }
+        assert!(check_destination(RELAY.trim_end_matches('/'), RELAY).is_err());
+    }
+    #[test]
+    fn only_private_sole_publisher_synthetic_metadata_can_skip_discovery() -> Result<()> {
+        let good = RepoRef {
+            name: "synthetic".into(),
+            description: "test".into(),
+            identifier: "synthetic".into(),
+            root_commit: "1234567890abcdef1234567890abcdef12345678".into(),
+            git_server: vec![CLONE.into()],
+            web: vec![],
+            upstream: vec![],
+            relays: vec![RelayUrl::parse(RELAY)?],
+            blossoms: vec![],
+            hashtags: vec![],
+            private: true,
+            maintainers: vec![public_key()],
+            selected_maintainer: public_key(),
+            maintainers_without_annoucnement: None,
+            events: Default::default(),
+            nostr_git_url: None,
+            extra_tags: vec![],
+            role_tags: vec![],
+            moderators: vec![],
+            lead: None,
+        };
+        assert!(require_repo(&good).is_ok());
+        for field in 0..6 {
+            let mut bad = good.clone();
+            match field {
+                0 => bad.private = false,
+                1 => bad.identifier = "other".into(),
+                2 => bad
+                    .git_server
+                    .push("https://example.invalid/repo.git".into()),
+                3 => bad.relays.push(RelayUrl::parse("wss://example.invalid/")?),
+                4 => bad
+                    .maintainers
+                    .push(nostr::prelude::Keys::generate().public_key()),
+                _ => bad.web.push("https://example.invalid/".into()),
+            }
+            assert!(require_repo(&bad).is_err());
+        }
+        Ok(())
+    }
+    #[test]
+    fn overriding_params_removes_every_public_fallback_and_local_key() {
+        let mut params = Params::default();
+        params.keys = Some(nostr::prelude::Keys::generate());
+        constrain_params(&mut params);
+        assert!(params.keys.is_none());
+        assert_eq!(params.relay_default_set, vec![RELAY]);
+        assert_eq!(params.fallback_signer_relays, vec![RELAY]);
+        assert!(params.announcement_indexer_relays.is_empty());
+        assert!(params.blaster_relays.is_empty());
+        assert!(params.grasp_default_set.is_empty());
+    }
+}
